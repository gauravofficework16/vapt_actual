# ==================== Ollama Configuration ====================
# Configure Ollama server IP/port for different network setups
# Defaults: IP=172.17.63.4, PORT=11434, MODEL=gpt-oss:20b, TIMEOUT=300
# Override these to use Ollama from another IP in your network
OLLAMA_IP=172.17.63.4
OLLAMA_PORT=11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT=300

# ==================== LangSmith Tracing Configuration ====================
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="<your-langsmith-api-key>"
LANGSMITH_PROJECT="VAPT_Pipeline"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# ==================== Git Access Configuration ====================
GIT_ACCESS_TOKEN="<your-git-access-token>"

# ==================== Target Repository Configuration ====================
# Override these at runtime or use defaults in graph_refactored.py
TARGET_REPO_URL="https://gitlab.com/your-org/your-repo.git"
TARGET_BRANCH="main"

# ==================== Optional: Enable Deterministic Scanners ====================
# Set to "true" to enable Semgrep/Bandit hybrid analysis (requires installation)
ENABLE_SEMGREP=false
ENABLE_BANDIT=false

